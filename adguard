mixed-port: 7890
mode: rule
unified-delay: true
log-level: error
ipv6: false
external-controller: 127.0.0.1:9090
secret: 143772bab9dfbb86
find-process-mode: always
global-client-fingerprint: chrome

dns:
  enable: true
  prefer-h3: true
  ipv6: false
  use-hosts: true
  use-system-hosts: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 172.19.0.1/16
  nameserver:
    # --- ADGUARD (UTAMA UNTUK BLOKIR DNS LEVEL) ---
    - https://dns.adguard-dns.com/dns-query
    - quic://dns.adguard-dns.com:784
    # --- GOOGLE & CLOUDFLARE (BACKUP) ---
    - 8.8.8.8
    - 1.1.1.1
  fallback:
    - https://dns.google/dns-query
    - https://1.1.1.1/dns-query
  fake-ip-filter:
    # Whitelist agar tidak menggunakan Fake-IP pada domain krusial
    - 'moviehub.xinquins.dpdns.org'
    - '*.vercel.app'
    - 'vercel.com'
    - '+.push.apple.com'
    - '+.stun.*'
    - '+.xinquins.dpdns.org'

tun:
  enable: true
  device: Clash Mi
  stack: gvisor
  dns-hijack:
    - 0.0.0.0:53
  auto-route: true # Diubah ke true agar otomatis menangkap trafik jika di Android/PC
  auto-detect-interface: true
  mtu: 9000

proxies:
  - name: ID - PT Pusat Media Indonesia [VLESS-TLS]
    type: vless
    server: api24-normal.tiktokv.com.redirect.benxx.workers.dev
    port: 443
    uuid: b5a60e4a-498b-4fb9-9988-09289404903c
    tls: true
    servername: api24-normal.tiktokv.com.redirect.benxx.workers.dev
    network: ws
    ws-opts:
      path: /103.6.207.108-8080
      headers:
        host: api24-normal.tiktokv.com.redirect.benxx.workers.dev
  - name: xcp
    type: vless
    server: 172.66.1.232
    port: 443
    uuid: 2bcfbfba-b446-4ad5-93ad-72af9e008f61
    tls: true
    servername: api24-normal.tiktokv.com.hu.xinquins.dpdns.org
    network: ws
    ws-opts:
      path: /43.218.77.16-1443
      headers:
        host: api24-normal.tiktokv.com.hu.xinquins.dpdns.org
  - name: 'Netflix '
    type: vless
    server: redirect-1.benxx.workers.dev
    port: 443
    uuid: 2bcfbfba-b446-4ad5-93ad-72af9e008f61
    tls: true
    servername: redirect-1.benxx.workers.dev
    network: ws
    ws-opts:
      path: /47.74.254.191-8900
      headers:
        host: redirect-1.benxx.workers.dev

proxy-groups:
  - name: 🚀 Benxx Project
    type: select
    proxies:
      - ⚡ Auto Select
      - ID - PT Pusat Media Indonesia [VLESS-TLS]
      - xcp
      - 'Netflix '
      - DIRECT

  - name: ⚡ Auto Select
    type: url-test
    proxies:
      - ID - PT Pusat Media Indonesia [VLESS-TLS]
      - xcp
      - 'Netflix '
    url: https://www.gstatic.com/generate_204
    interval: 300

  - name: 🛑 Ad Blocking
    type: select
    proxies:
      - REJECT
      - DIRECT

rule-providers:
  category-ads-all:
    type: http
    format: mrs
    behavior: domain
    url: https://gh-proxy.com/https://github.com/MetaCubeX/meta-rules-dat/raw/refs/heads/meta/geo/geosite/category-ads-all.mrs
    path: ./ruleset/category-ads-all.mrs
    interval: 86400

rules:
  # --- [1] BYPASS / WHITELIST (Agar API tidak Error) ---
  - DOMAIN-SUFFIX,vercel.app,DIRECT
  - DOMAIN-SUFFIX,vercel.com,DIRECT
  - DOMAIN-KEYWORD,xinquins,DIRECT
  - DOMAIN,moviehub.xinquins.dpdns.org,DIRECT
  
  # --- [2] AD BLOCKING ---
  - RULE-SET,category-ads-all,🛑 Ad Blocking
  
  # --- [3] OTHERS ---
  - GEOIP,google,🚀 Benxx Project
  - MATCH,🚀 Benxx Project
