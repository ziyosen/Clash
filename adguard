dns:
  enable: true
  prefer-h3: true
  ipv6: false
  use-hosts: true
  use-system-hosts: true
  respect-rules: true
  enhanced-mode: fake-ip
  fake-ip-range: 172.19.0.1/16
  nameserver:
    # DNS AdGuard tetep ada tapi kita kasih backup yang kenceng
    - https://dns.adguard-dns.com/dns-query
    - 8.8.8.8
    - 1.1.1.1
  fallback:
    - https://dns.google/dns-query
  fake-ip-filter:
    # Tambahkan lebih banyak filter supaya tidak di-proxy secara DNS
    - 'moviehub.xinquins.dpdns.org'
    - '*.vercel.app'
    - 'vercel.com'
    - '*.firebaseio.com' # Sering dipake buat API
    - '+.push.apple.com'
    - '+.stun.*'

# ... (bagian proxies & proxy-groups tetap sama)

rules:
  # 1. WHITELIST UTAMA (Harus paling atas)
  - DOMAIN-SUFFIX,vercel.app,DIRECT
  - DOMAIN-SUFFIX,vercel.com,DIRECT
  - DOMAIN,moviehub.xinquins.dpdns.org,DIRECT
  - DOMAIN-KEYWORD,xinquins,DIRECT
  
  # 2. AD BLOCKING (Pakai REJECT biar nggak bengong nunggu timeout)
  - RULE-SET,category-ads-all,REJECT 
  
  # 3. SISANYA
  - GEOIP,google,🚀 Benxx Project
  - MATCH,🚀 Benxx Project
